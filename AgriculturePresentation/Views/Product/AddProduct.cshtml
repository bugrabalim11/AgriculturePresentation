@model EntityLayer.Concrete.Product
@{
    ViewData["Title"] = "AddProduct";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Yeni Ürün Kaydı</h4>
            <form class="forms-sample" method="post">
                <div class="form-group">
                    <label for="Title">Başlık</label>
                    <span asp-validation-for="ProductName" class="text-danger"></span>
                    <input type="text" class="form-control" placeholder="başlık giriniz" asp-for="ProductName">
                    </div>
                    <div class="form-group">
                        <label for="ImageUrl">Miktar</label>
                        <span asp-validation-for="Value" class="text-danger"></span>
                        <input type="text" class="form-control" placeholder="kilogram" asp-for="Value">
                        </div>
                        <button type="submit" class="btn btn-outline-info me-2">Kaydet</button>
                    </form>
                </div>
            </div>
        </div>
