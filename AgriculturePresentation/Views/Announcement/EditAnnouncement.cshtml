@model EntityLayer.Concrete.Announcement
@{
    ViewData["Title"] = "EditAnnouncement";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Duyuru Güncelleme Sayfası</h4>
            <form class="forms-sample" method="post">
                @Html.HiddenFor(x=>x.AnnouncementID)
                <div class="form-group">
                    <label for="PersonName">Başlık</label>
                    <input type="text" class="form-control" id="PersonName" placeholder="başlık giriniz" asp-for="Title">
                    </div>
                    <div class="form-group">
                        <label for="PersonName">Tarih</label>
                        <input type="date" class="form-control" id="PersonName" placeholder="tarih giriniz" asp-for="Date">
                        </div>
                        <div class="form-group">
                            <label for="Title">Açıklama</label>
                            <textarea cols="30" rows="5" asp-for="Description" class="form-control" placeholder="açıklamayı giriniz"></textarea>
                        </div>
                        <button type="submit" class="btn btn-outline-info me-2">Kaydet</button>
                    </form>
                </div>
            </div>
        </div>
