@model EntityLayer.Concrete.Team
@{
    ViewData["Title"] = "AddTeam";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Yeni Takım Arkadaşı Kaydı</h4>
            <form class="forms-sample" method="post">
                
                <div class="form-group">
                    <label for="PersonName">Adı Soyadı</label>
                    <span asp-validation-for="PersonName" class="text-danger"></span>
                    <input type="text" class="form-control" id="PersonName" placeholder="Ad Soyad" asp-for="PersonName">
                    </div>
                
                    <div class="form-group">
                        <label for="Title">Görev</label>
                        <span asp-validation-for="Title" class="text-danger"></span>
                        <input type="text" class="form-control" id="Title" placeholder="Örn: Yazılım Mühendisi" asp-for="Title">
                        </div>
                
                        <div class="form-group">
                            <label for="ImageUrl">Görsel Yolu</label>
                            <span asp-validation-for="ImageUrl" class="text-danger"></span>
                            <input type="text" class="form-control" id="ImageUrl" placeholder="Görsel Yolu" asp-for="ImageUrl">
                            </div>
                
                            <div class="form-group">
                                <label for="FacebookUrl">Facebook</label>
                                <input type="text" class="form-control" id="FacebookUrl" placeholder="Facebook Linki" asp-for="FacebookUrl">
                                </div>
                
                                <div class="form-group">
                                    <label for="InstagramUrl">Instagram</label>
                                    <input type="text" class="form-control" id="InstagramUrl" placeholder="Instagram Linki" asp-for="InstagramUrl">
                                    </div>
                
                                    <div class="form-group">
                                        <label for="XUrl">X (Twitter)</label>
                                        <input type="text" class="form-control" id="XUrl" placeholder="X Linki" asp-for="XUrl">
                                        </div>
                
                                        <div class="form-group">
                                            <label for="WebsiteUrl">Web Sitesi</label>
                                            <input type="text" class="form-control" id="WebsiteUrl" placeholder="Web Sitesi Linki" asp-for="WebsiteUrl">
                                            </div>
                
                                            <button type="submit" class="btn btn-outline-info me-2">Kaydet</button>
                                        </form>
                                    </div>
                                </div>
                            </div>